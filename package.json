{
  "name": "seoul-stay-pathfinder",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:api": "tsx watch src/server/server.ts",
    "dev:web": "vite",
    "build": "vite build && tsc -p tsconfig.server.json",
    "start": "node dist-server/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "ingest": "tsx src/server/jobs/ingest.ts",
    "verify:data": "tsx scripts/verify-data-sources.ts",
    "verify:route": "tsx scripts/verify-route-details.ts",
    "rag:setup": "tsx src/server/jobs/setupRag.ts"
  },
  "dependencies": {
    "@google-cloud/bigquery": "^9.0.1",
    "@google-cloud/storage": "^7.21.0",
    "@google/genai": "^1.29.1",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "google-auth-library": "^11.0.0",
    "leaflet": "^1.9.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-leaflet": "^5.0.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/express": "^5.0.5",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@types/supertest": "^6.0.3",
    "@vitejs/plugin-react": "^5.1.1",
    "jsdom": "^27.2.0",
    "jszip": "^3.10.1",
    "supertest": "^7.1.4",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^7.2.2",
    "vitest": "^4.0.13"
